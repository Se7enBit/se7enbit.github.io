---
import Base from "../layouts/Base.astro";
import Desktop from "../components/Desktop.svelte";
import MobileView from "../components/MobileView.astro";
import { profile } from "../data/profile";
import { LAUNCHED_KEY } from "../lib/desktop.svelte";
import { getProjects } from "../lib/projects";

const projects = await getProjects();

const title = `${profile.name} — ${profile.title}`;
const description = profile.bio;

// Structured data for search engines (schema.org Person), all from profile.ts.
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.title,
  description: profile.bio,
  url: Astro.site?.href,
  email: `mailto:${profile.email}`,
  sameAs: [profile.linkedin, ...profile.github],
  alumniOf: { "@type": "CollegeOrUniversity", name: profile.university },
  homeLocation: { "@type": "Place", name: profile.location },
};
// Escape "<" so profile text can never close the <script> tag.
const personJson = JSON.stringify(person).replace(/</g, "\\u003c");
---

<Base title={title} description={description}>
  <Fragment slot="head">
    <!--
      Runs before first paint:
      - `js` class: with JS on ≥768px the desktop replaces the static view (see global.css);
      - skip the launch screen if already launched this session.
    -->
    <script is:inline define:vars={{ key: LAUNCHED_KEY }}>
      document.documentElement.classList.add("js");
      try {
        if (sessionStorage.getItem(key) === "1") document.documentElement.dataset.launched = "";
      } catch {}
    </script>
    <script type="application/ld+json" is:inline set:html={personJson} />
  </Fragment>

  <!-- Desktop session: only hydrated (and only shown) on ≥768px with JS. -->
  <div class="desktop-root">
    <Desktop client:media="(min-width: 768px)" projects={projects} />
  </div>

  <!-- Static single-column view: mobile layout and no-JS fallback. -->
  <MobileView projects={projects} />
</Base>
